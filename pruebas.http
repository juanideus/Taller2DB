#################################################
############### API LIBRERÍA ####################
#################################################


#################################################
# AGREGAR LIBRO
#################################################

POST http://localhost:8080/libros
Content-Type: application/json

{
  "Nombre": "Cien años de soledads",
  "Genero": "ayuwoki",
  "Autor": "Gabriel Garcías Márquez",
  "fecha_recepcion": "2024-06-01",
  "cantidad_copias": 5,
  "edad_sugerida": 14,
  "editorial": "Sudamericana",
  "precio": 18500,
  "estado": 1
}


#################################################
# GENERAR COPIA DE UN LIBRO
#################################################

POST http://localhost:8080/libros/copy
Content-Type: application/json

{
  "id": 1,
  "codBarra": "12212212122"
}


#################################################
# AGREGAR USUARIO
#################################################

POST http://localhost:8080/users
Content-Type: application/json

{
  "nombre": "Juan Perez",
  "rut": "12345678-8",
  "direccion": "Av. Siempre Viva 123"
}


#################################################
# ACTUALIZAR PRECIO DE UN LIBRO
#################################################

PATCH http://localhost:8080/libros/1
Content-Type: application/json

{
  "precio": 41
}


#################################################
# DESHABILITAR COPIA DE UN LIBRO
#################################################

PATCH http://localhost:8080/libros/disable/1
Content-Type: application/json



#################################################
# DESHABILITAR USUARIO
#################################################
PATCH http://localhost:8080/users/disable/1
Content-Type: application/json


#################################################
# VER TODOS LOS LIBROS
#################################################

GET http://localhost:8080/libros
Content-Type: application/json


#################################################
# GENERAR TRANSACCION
#################################################
POST http://localhost:8080/transaction
Content-Type: application/json

{
  "Trabajadorid": 1,
  "Usuarioid": 1,
  "Copia_libroid": 4,
  "es_venta": true,
  "es_prestamo": false
}
#################################################
# Obtener detalles de una transacción
##############################################
get http://localhost:8080/transaction/details
Content-Type: application/json

{
  "id": 1,
  "date": "2024-06-01"
}
#################################################
# LOGIN DE USUARIO
#################################################
POST http://localhost:8080/users/login
Content-Type: application/json

{
  "email": "juan@correo.com",
  "password": "123456"  
}
###############################################
# REGISTRAR USUARIO
POST http://localhost:8080/users/register
Content-Type: application/json

{
  "nombre": "Juan Perez",
  "rut": "123456728-8",
  "direccion": "Av. Siempre Viva 123",
  "estado": 1
}