#################################################
############### API LIBRERÍA ####################
#################################################


#################################################
# AGREGAR LIBRO
#################################################

POST http://localhost:8080/libros
Content-Type: application/json

{
  "nombre": "Cien años de soledads",
  "genero": 1,
  "autor": "Gabriel Garcías Márquez",
  "fechaRecepcion": "2024-06-01",
  "cantCopias": 5,
  "edadSugerida": 14,
  "editorial": "Sudamericana",
  "precio": 18500,
  "estado": 1
}


#################################################
# GENERAR COPIA DE UN LIBRO
#################################################

POST http://localhost:8080/libros/copy
Content-Type: application/json

{
  "id": 1,
  "codBarra": "12213123"
}


#################################################
# AGREGAR USUARIO
#################################################

POST http://localhost:8080/users
Content-Type: application/json

{
  "nombre": "Juan Perez",
  "edad": 25,
  "rut": "12345678-9",
  "direccion": "Av. Siempre Viva 123"
}


#################################################
# ACTUALIZAR PRECIO DE UN LIBRO
#################################################

PATCH http://localhost:8080/libros
Content-Type: application/json

{
  "id": 2,
  "precio": 41
}


#################################################
# DESHABILITAR COPIA DE UN LIBRO
#################################################

PATCH http://localhost:8080/libros/disable
Content-Type: application/json

{
  "id": 1
}

#################################################
# DESHABILITAR USUARIO
#################################################
PATCH http://localhost:8080/users/disable
Content-Type: application/json

{
  "rut": "12345678-9"
}


#################################################
# VER TODOS LOS LIBROS
#################################################

GET http://localhost:8080/libros
Content-Type: application/json


#################################################
# GENERAR TRANSACCION
#################################################
POST http://localhost:8080/transaction
Content-Type: application/json

{
  "idTrabajador": 1,
  "idUsuario": 1,
  "Fecha": "2024-06-01",
  "semestre": "2024-1",
  "precio_total": 18500,
  "Copia_libroid": 1,
  "esVenta": true,
  "esPrestamo": false
}